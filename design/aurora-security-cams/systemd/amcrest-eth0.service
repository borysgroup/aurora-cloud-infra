# Put the Pi 5's eth0 on the Amcrest camera segment at boot: a static address,
# no gateway, never the default route, no DNS, no IPv6, and an unsaved
# NetworkManager profile, so nothing is written to disk and the default route
# stays on Wi-Fi. ip_forward stays 0, so the cameras keep no internet path.
# Not installed yet: the address (.199) is pending confirmation (README, item 6).
[Unit]
Description=Gateway-less eth0 address on the Amcrest camera segment
Wants=NetworkManager.service
After=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/bin/nmcli connection delete cam-link
ExecStart=/usr/bin/nmcli connection add type ethernet ifname eth0 con-name cam-link \
    ipv4.method manual ipv4.addresses 192.168.3.199/24 ipv4.never-default yes \
    ipv4.ignore-auto-dns yes ipv4.dad-timeout 3000 ipv6.method disabled \
    connection.autoconnect no save no
ExecStart=/usr/bin/nmcli -w 20 connection up cam-link
ExecStop=-/usr/bin/nmcli connection delete cam-link

[Install]
WantedBy=multi-user.target
